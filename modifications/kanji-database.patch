+
+<!-- Modification: Kanji DB -->
+<script>
+    async function loadKDB() {
+        if (window._kdb) return window._kdb;
+
+        return new Promise((resolve, reject) => {
+            const script = document.createElement("script");
+
+            script.onload = () => {
+                const check = setInterval(() => {
+                    if (window._kdb) {
+                        clearInterval(check);
+                        resolve(window._kdb);
+                    }
+                }, 10);
+
+                setTimeout(() => {
+                    clearInterval(check);
+                    reject(new Error("Could not load KDB"));
+                }, 1000);
+            };
+
+            script.src = "_kdb.js";
+            script.onerror = () => reject(new Error(`Failed to load ${script.src}`));
+
+            document.head.appendChild(script);
+        });
+    }
+
+    (async () => {
+        const word = document.querySelector("#word").innerHTML;
+        const container = document.querySelector(".kdb");
+
+        container.innerHTML = "";
+
+        try {
+            const kdb = await loadKDB();
+            const kanjis = word.replace(/[\u3040-\u309F\u30A0-\u30FF]/g, "").split("");
+
+            if (kanjis.length == 0) {
+                container.remove();
+                return;
+            }
+
+            const generate = (title, data, index) => {
+                const readings = data.reading[index];
+                if (readings.length == 0) return "";
+
+                return `
+                    <div class="kdb-reading">
+                        <span class="kdb-reading-title">${title}:</span>
+                        <span class="kdb-reading-list">${readings.join(", ")}</span>
+                    </div>
+                `;
+            };
+
+            kanjis.forEach((kanji) => {
+                const data = kdb[kanji];
+                if (!data) return;
+
+                const meanings = data.meaning.join("; ") || "No Meaning";
+                const tags = Object.keys(data.tags)
+                    .map((tag) => `<span>${tag}: ${data.tags[tag]}</span>`)
+                    .join("");
+
+                container.insertAdjacentHTML("afterbegin", `
+                    <div class="kdb-kanji">
+                        <h1>${kanji}</h1>
+                        <div class="kdb-content">
+                            <h2>${meanings}</h2>
+                            <div class="kdb-tags">${tags}</div>
+
+                            <div class="kdb-readings">
+                                ${generate("訓読み", data, "kun")}
+                                ${generate("音読み", data, "on")}
+                                ${generate("名乗り", data, "nanori")}
+                            </p>
+                        </div>
+                    </div>
+                `);
+            });
+        } catch (err) {
+            console.error("Could not get _kdb.js", err);
+        }
+    })();
+</script>
