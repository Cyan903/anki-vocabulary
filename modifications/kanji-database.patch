+
+/* Kanji Database */
+.kdb {
+    margin-top: 2em;
+}
+
+.kdb-kanji {
+    display: grid;
+    grid-template-columns: 20% 80%;
+    border: 1px solid transparent;
+    margin-bottom: 1em;
+}
+
+.kdb-kanji h1 {
+    font-size: 4em;
+    margin: 0;
+    padding-top: 10px;
+}
+
+.kdb-content {
+    text-align: left;
+}
+
+.kdb-tags {
+    display: block;
+    list-style-type: none;
+    padding-bottom: 0.5em;
+}
+
+.kdb-tags span {
+    display: inline-block;
+    background-color: var(--secondary);
+    color: #000;
+    font-size: 0.8em;
+    border-radius: 3px;
+    padding: 2px 5px;
+    font-weight: bold;
+    margin-right: 1em;
+    margin-bottom: 1em;
+    text-transform: capitalize;
+}
+
+.kdb-reading-title {
+    font-weight: bolder;
+}
+
+@media screen and (max-width: 700px) {
+    .kdb-kanji {
+        display: block;
+        padding: 0 15px;
+    }
+
+    .kdb-kanji h1 {
+        padding-top: 0;
+    }
+
+    .kdb-content h2,
+    .kdb-tags {
+        text-align: center;
+    }
+
+    .kdb-tags span {
+        margin: 5px;
+    }
+
+    .kdb-readings {
+        margin-top: 1em;
+    }
+}
